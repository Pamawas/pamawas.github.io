---
import Layout from '../layouts/Layout.astro';
import OperationalHero from '../components/OperationalHero.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import InvestigationWorkspace from '../components/InvestigationWorkspace.astro';
import SystemArchitecture from '../components/SystemArchitecture.astro';
import TrustAndSetup from '../components/TrustAndSetup.astro';
---

<Layout title="Pamawas — Evidence-backed infrastructure incident investigation" description="Pamawas turns alert noise into concise, evidence-backed infrastructure incident reports using deterministic correlation and bounded read-only AI investigation.">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <nav class="shell nav-inner" aria-label="Primary navigation">
      <a class="brand" href="#main" aria-label="Pamawas home"><span class="brand-mark" aria-hidden="true">P</span><span>Pamawas</span></a>
      <div class="nav-links">
        <a href="#investigation">Investigation</a>
        <a href="#architecture">Architecture</a>
        <a href="#trust">Trust model</a>
        <a href="#quick-start">Quick start</a>
      </div>
      <div class="nav-actions">
        <button id="theme-toggle" class="icon-button" type="button" aria-label="Switch to light theme" title="Switch theme">
          <svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"/></svg>
          <svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/></svg>
        </button>
        <a class="nav-github" href="https://github.com/Pamawas" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </nav>
  </header>

  <main id="main">
    <OperationalHero />
    <WorkflowSection />
    <InvestigationWorkspace />
    <SystemArchitecture />
    <TrustAndSetup />
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <div><a class="brand footer-brand" href="#main"><span class="brand-mark" aria-hidden="true">P</span><span>Pamawas</span></a><p>Evidence-backed incident investigation for infrastructure teams.</p></div>
      <div class="footer-links"><a href="https://github.com/Pamawas/pamawas-schema/blob/main/docs/mvp-design.md" target="_blank" rel="noopener">MVP design</a><a href="https://github.com/Pamawas/pamawas-schema/blob/main/docs/grand-design.md" target="_blank" rel="noopener">Grand design</a><a href="https://github.com/Pamawas" target="_blank" rel="noopener">GitHub organization</a></div>
      <p class="footer-note">Open source · MIT License</p>
    </div>
  </footer>

  <script>
    const root = document.documentElement;
    const themeToggle = document.getElementById('theme-toggle');

    function currentTheme() {
      const explicit = root.getAttribute('data-theme');
      if (explicit === 'light' || explicit === 'dark') return explicit;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function syncThemeLabel() {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      themeToggle?.setAttribute('aria-label', `Switch to ${next} theme`);
    }

    themeToggle?.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      root.classList.toggle('dark', next === 'dark');
      localStorage.setItem('theme', next);
      syncThemeLabel();
    });
    syncThemeLabel();

    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    function activateTab(tab: HTMLButtonElement, focus = false) {
      tabs.forEach((item) => {
        const selected = item === tab;
        item.classList.toggle('active', selected);
        item.setAttribute('aria-selected', String(selected));
        item.tabIndex = selected ? 0 : -1;
        const panelId = item.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;
        if (panel) {
          panel.hidden = !selected;
          panel.classList.toggle('active', selected);
        }
      });
      if (focus) tab.focus();
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateTab(tab));
      tab.addEventListener('keydown', (event) => {
        let nextIndex: number | null = null;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;
        if (nextIndex !== null) {
          event.preventDefault();
          activateTab(tabs[nextIndex], true);
        }
      });
    });

    const copyButton = document.getElementById('copy-code-btn');
    const quickstart = document.getElementById('quickstart-code');
    const copyStatus = document.getElementById('copy-status');
    copyButton?.addEventListener('click', async () => {
      if (!quickstart) return;
      try {
        await navigator.clipboard.writeText(quickstart.innerText);
        const label = copyButton.querySelector('.copy-text');
        if (label) label.textContent = 'Copied';
        if (copyStatus) copyStatus.textContent = 'Quick start commands copied to clipboard.';
        window.setTimeout(() => { if (label) label.textContent = 'Copy'; }, 1800);
      } catch {
        if (copyStatus) copyStatus.textContent = 'Unable to copy commands. Select the command block manually.';
      }
    });
  </script>
</Layout>
