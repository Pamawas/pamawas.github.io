---
const claims = [
  { tone: 'fact', label: 'FACT', text: 'Active connections reached the configured maximum ceiling (100%).', source: 'prometheus:db_connections_active' },
  { tone: 'likely', label: 'LIKELY', text: 'Pool exhaustion caused subsequent checkout request timeouts and 500s.', source: 'supports: ev_01, ev_02' },
  { tone: 'hypothesis', label: 'HYPOTHESIS', text: 'Recent pool size configuration change reduced operational headroom.', source: 'unverified' },
  { tone: 'unknown', label: 'UNKNOWN', text: 'No deployment adapter is configured, so change correlation cannot be asserted.', source: 'adapter_not_configured' },
];

const provenanceItems = [
  { label: 'Run ID', value: 'irun_01j7x8a92k0' },
  { label: 'Model spec', value: 'gemini-2.5-pro · temp 0.0 · system_contract_v3' },
  { label: 'Contracts', value: 'investigator_prompt_v1.4.2 · schema_2026_08' },
  { label: 'Tool invocations', value: '4 queries (promql_instant, loki_range) · 0 writes' },
  { label: 'Verification hash', value: 'sha256:4a8b79f912c98d63a8e91823bc...' },
];

const failureRules = [
  { trigger: 'Unavailable adapter', result: 'Returns explicit unavailable error; the agent is barred from mocking observations.' },
  { trigger: 'Insufficient evidence', result: 'Persists an explicit UNKNOWN claim; never forces an RCA conclusion.' },
  { trigger: 'Persistence failure', result: 'Rolls back all evidence claims atomically; no partial dirty state.' },
  { trigger: 'Network retries', result: 'Reuses stable run idempotency keys; prevents duplicate report entries.' },
];
---
<section id="investigation" class="investigation-section" aria-labelledby="investigation-title">
  <div class="shell">
    <header class="section-header reveal-item">
      <div>
        <p class="eyebrow">Evidence model</p>
        <h2 id="investigation-title">A conclusion is only as useful<br />as its receipts.</h2>
      </div>
      <p>
        Findings strictly record source, confidence level, supporting telemetry references, potential contradictions, and the reproducible run context that produced them.
      </p>
    </header>

    <div class="investigation-workspace reveal-item">
      <div class="investigation-tabs" role="tablist" aria-label="Investigation record views">
        <button id="tab-evidence" class="investigation-tab-btn" role="tab" aria-selected="true" aria-controls="panel-evidence" tabindex="0">
          Evidence
        </button>
        <button id="tab-provenance" class="investigation-tab-btn" role="tab" aria-selected="false" aria-controls="panel-provenance" tabindex="-1">
          Provenance
        </button>
        <button id="tab-failure" class="investigation-tab-btn" role="tab" aria-selected="false" aria-controls="panel-failure" tabindex="-1">
          Failure semantics
        </button>
      </div>

      <!-- Panel 01: Evidence -->
      <div id="panel-evidence" class="investigation-panel" role="tabpanel" aria-labelledby="tab-evidence" tabindex="0">
        <div class="panel-intro-block">
          <div>
            <p class="panel-kicker">Representative evidence set</p>
            <h3>Typed claims keep certainty visible.</h3>
          </div>
          <span class="demo-chip">Illustrative data</span>
        </div>

        <div class="claims-grid">
          {claims.map((claim) => (
            <article class={`claim-box claim-row ${claim.tone}`}>
              <div class="claim-box-head">
                <span class={`pill-badge ${claim.tone}`}>{claim.label}</span>
              </div>
              <p>{claim.text}</p>
              <small>{claim.source}</small>
            </article>
          ))}
        </div>
      </div>

      <!-- Panel 02: Provenance -->
      <div id="panel-provenance" class="investigation-panel" role="tabpanel" aria-labelledby="tab-provenance" tabindex="0" hidden>
        <div class="panel-intro-block">
          <div>
            <p class="panel-kicker">Reproducible by design</p>
            <h3>Every result traces to its execution context.</h3>
          </div>
          <span class="demo-chip">Trace record</span>
        </div>

        <dl class="provenance-matrix">
          {provenanceItems.map((item) => (
            <div class="provenance-row">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Panel 03: Failure Semantics -->
      <div id="panel-failure" class="investigation-panel" role="tabpanel" aria-labelledby="tab-failure" tabindex="0" hidden>
        <div class="panel-intro-block">
          <div>
            <p class="panel-kicker">Honest under failure</p>
            <h3>Partial evidence never masquerades as certainty.</h3>
          </div>
          <span class="demo-chip">Reliability rules</span>
        </div>

        <ul class="failure-matrix">
          {failureRules.map((rule) => (
            <li>
              <b>{rule.trigger}</b>
              <span>{rule.result}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
