---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`arch-canvas ${className}`} role="region" aria-label="Pamawas Architecture Pipeline">
  <!-- Visual Header Bar -->
  <div class="arch-top-bar">
    <div class="arch-status-pill">
      <span class="pulse-dot"></span>
      <span class="status-label">End-to-End Incident Pipeline</span>
    </div>
    <div class="arch-meta-tags">
      <span class="meta-tag">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Read-Only Safe
      </span>
      <span class="meta-tag">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        Deterministic Grouping
      </span>
      <span class="meta-tag">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        Daily Morning Digest
      </span>
    </div>
  </div>

  <div class="pipeline-container">
    <!-- TIER 1: INGESTION & STORAGE -->
    <div class="pipeline-tier">
      <div class="tier-header">
        <span class="tier-tag">STAGE 1 &bull; INGESTION &amp; PERSISTENCE</span>
      </div>
      <div class="tier-row">
        <!-- Sources Block -->
        <div class="flow-stage sources-stage">
          <div class="stage-top">
            <span class="stage-tag">01 / Influx</span>
            <span class="stage-badge badge-neutral">Sources</span>
          </div>
          <h3 class="stage-heading">Alert Influx</h3>
          <p class="stage-sub">Metrics, logs & webhooks</p>
          <div class="sources-list">
            <div class="source-item">
              <span class="source-icon">📊</span>
              <div class="source-info">
                <span class="source-name">Grafana</span>
                <span class="source-type">Alerts</span>
              </div>
            </div>
            <div class="source-item">
              <span class="source-icon">🔥</span>
              <div class="source-info">
                <span class="source-name">Prometheus</span>
                <span class="source-type">Alertmanager</span>
              </div>
            </div>
            <div class="source-item">
              <span class="source-icon">📜</span>
              <div class="source-info">
                <span class="source-name">Loki</span>
                <span class="source-type">Log Streams</span>
              </div>
            </div>
            <div class="source-item">
              <span class="source-icon">⚡</span>
              <div class="source-info">
                <span class="source-name">Custom Hook</span>
                <span class="source-type">Any JSON</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Connector 1 -->
        <div class="flow-connector">
          <div class="connector-line">
            <span class="flow-bubble flow-b1"></span>
          </div>
          <span class="connector-label">Normalize</span>
        </div>

        <!-- Stage 2: Ingest -->
        <div class="flow-stage card-stage">
          <div class="stage-top">
            <span class="stage-tag">02 / Processing</span>
            <span class="stage-badge badge-indigo">Go Service</span>
          </div>
          <h3 class="stage-heading">Ingest API</h3>
          <p class="stage-sub">pamawas-ingest</p>
          <ul class="stage-features">
            <li><span>✓</span> Ingests raw alert payloads</li>
            <li><span>✓</span> Validates & maps to unified schema</li>
            <li><span>✓</span> Durable idempotent ingestion</li>
          </ul>
        </div>

        <!-- Connector 2 -->
        <div class="flow-connector">
          <div class="connector-line">
            <span class="flow-bubble flow-b2"></span>
          </div>
          <span class="connector-label">Persist</span>
        </div>

        <!-- Stage 3: Database -->
        <div class="flow-stage card-stage">
          <div class="stage-top">
            <span class="stage-tag">03 / Evidence</span>
            <span class="stage-badge badge-blue">PostgreSQL</span>
          </div>
          <h3 class="stage-heading">Evidence Vault</h3>
          <p class="stage-sub">pamawas-schema</p>
          <ul class="stage-features">
            <li><span>✓</span> PostgreSQL-backed durable state</li>
            <li><span>✓</span> Typed incident and evidence records</li>
            <li><span>✓</span> Traceable provenance and reviews</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Tier Bridge -->
    <div class="tier-bridge">
      <div class="bridge-line">
        <span class="bridge-bubble"></span>
      </div>
      <span class="bridge-label">Automatic Investigation &amp; Correlation Flow</span>
    </div>

    <!-- TIER 2: CORRELATION, INVESTIGATION & DELIVERY -->
    <div class="pipeline-tier">
      <div class="tier-header">
        <span class="tier-tag">STAGE 2 &bull; CORRELATION &amp; ANALYSIS</span>
      </div>
      <div class="tier-row">
        <!-- Stage 4: Correlator -->
        <div class="flow-stage card-stage">
          <div class="stage-top">
            <span class="stage-tag">04 / Grouping</span>
            <span class="stage-badge badge-purple">Go Service</span>
          </div>
          <h3 class="stage-heading">Correlator</h3>
          <p class="stage-sub">pamawas-correlator</p>
          <ul class="stage-features">
            <li><span>✓</span> Sliding time-window grouping</li>
            <li><span>✓</span> Strong service & identity-label rules</li>
            <li><span>✓</span> Versioned deterministic grouping</li>
          </ul>
        </div>

        <!-- Connector 4 -->
        <div class="flow-connector">
          <div class="connector-line">
            <span class="flow-bubble flow-b3"></span>
          </div>
          <span class="connector-label">Investigate</span>
        </div>

        <!-- Stage 5: Investigator -->
        <div class="flow-stage card-stage highlight-stage">
          <div class="stage-top">
            <span class="stage-tag">05 / Bounded AI</span>
            <span class="stage-badge badge-amber">Python Agent</span>
          </div>
          <h3 class="stage-heading">Investigator</h3>
          <p class="stage-sub">pamawas-investigator</p>
          <ul class="stage-features">
            <li><span>✓</span> PromQL, LogQL & configured adapters</li>
            <li><span>✓</span> Read-only bounded tool queries</li>
            <li><span>✓</span> Categorized confidence findings</li>
          </ul>
          <div class="evidence-types-mini">
            <span class="chip chip-fact">FACT</span>
            <span class="chip chip-likely">LIKELY CAUSE</span>
            <span class="chip chip-hypo">HYPOTHESIS</span>
            <span class="chip">UNKNOWN</span>
          </div>
        </div>

        <!-- Connector 5 -->
        <div class="flow-connector">
          <div class="connector-line">
            <span class="flow-bubble flow-b4"></span>
          </div>
          <span class="connector-label">Deliver</span>
        </div>

        <!-- Stage 6: Delivery -->
        <div class="flow-stage card-stage">
          <div class="stage-top">
            <span class="stage-tag">06 / Output</span>
            <span class="stage-badge badge-emerald">Go Service</span>
          </div>
          <h3 class="stage-heading">Delivery</h3>
          <p class="stage-sub">pamawas-reporter</p>
          <ul class="stage-features">
            <li><span>✓</span> Concise daily morning digest</li>
            <li><span>✓</span> Instant high-severity notifications</li>
            <li><span>✓</span> Discord, Telegram, Email adapters</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .arch-canvas {
    background: var(--arch-shell);
    border: 1px solid var(--arch-shell-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: var(--shadow-strong);
    color: var(--arch-text);
    width: 100%;
    box-sizing: border-box;
  }

  .arch-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 18px;
    border-bottom: 1px solid color-mix(in oklab, var(--arch-shell-border) 80%, transparent);
    margin-bottom: 22px;
  }

  .arch-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(20, 122, 105, 0.18);
    border: 1px solid rgba(95, 212, 191, 0.35);
    padding: 5px 14px;
    border-radius: 999px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #5fd4bf;
    box-shadow: 0 0 8px #5fd4bf;
    animation: pulseGlow 1.8s infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .status-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #5fd4bf;
    text-transform: uppercase;
  }

  .arch-meta-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .meta-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.76rem;
    padding: 4px 10px;
    border-radius: 6px;
    background: color-mix(in oklab, var(--arch-shell-border) 45%, transparent);
    border: 1px solid var(--arch-shell-border);
    color: #9bb1d6;
    font-weight: 600;
  }

  .pipeline-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  .pipeline-tier {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .tier-header {
    display: flex;
    align-items: center;
  }

  .tier-tag {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #8da4cb;
    text-transform: uppercase;
  }

  .tier-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: stretch;
    gap: 10px;
    width: 100%;
  }

  @media (max-width: 960px) {
    .tier-row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  .flow-stage {
    background: color-mix(in oklab, var(--arch-shell) 70%, #17243c);
    border: 1px solid var(--arch-shell-border);
    border-radius: 14px;
    padding: 16px 18px;
    position: relative;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .flow-stage:hover {
    transform: translateY(-2px);
    border-color: #5572a5;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
  }

  .stage-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .stage-tag {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #7d93be;
  }

  .stage-badge {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge-neutral { background: rgba(255, 255, 255, 0.08); color: #cbd5e1; border: 1px solid rgba(255, 255, 255, 0.15); }
  .badge-indigo { background: rgba(113, 112, 255, 0.18); color: #9f9eff; border: 1px solid rgba(113, 112, 255, 0.4); }
  .badge-blue { background: rgba(59, 130, 246, 0.18); color: #7cb3ff; border: 1px solid rgba(59, 130, 246, 0.4); }
  .badge-purple { background: rgba(168, 85, 247, 0.18); color: #c48dfc; border: 1px solid rgba(168, 85, 247, 0.4); }
  .badge-amber { background: rgba(245, 158, 11, 0.18); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); }
  .badge-emerald { background: rgba(16, 185, 129, 0.18); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.4); }

  .stage-heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: #f1f6ff;
    margin-bottom: 2px;
    line-height: 1.2;
  }

  .stage-sub {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #8da4cb;
    margin-bottom: 12px;
  }

  .stage-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.82rem;
    color: #c0d1ee;
    flex-grow: 1;
  }

  .stage-features li {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    line-height: 1.4;
  }

  .stage-features span {
    color: #5fd4bf;
    font-weight: 700;
    font-size: 0.74rem;
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* Sources stage */
  .sources-stage {
    background: color-mix(in oklab, var(--arch-shell) 85%, #0f1828);
  }

  .sources-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7px;
    margin-top: auto;
  }

  .source-item {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid color-mix(in oklab, var(--arch-shell-border) 60%, transparent);
    padding: 6px 8px;
    border-radius: 8px;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .source-item:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: #5572a5;
  }

  .source-icon {
    font-size: 0.95rem;
    line-height: 1;
  }

  .source-info {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .source-name {
    font-size: 0.76rem;
    font-weight: 700;
    color: #e2ecfd;
  }

  .source-type {
    font-size: 0.64rem;
    color: #8da4cc;
    font-family: var(--font-mono);
  }

  /* Investigator highlight */
  .highlight-stage {
    border-color: rgba(245, 158, 11, 0.45);
    background: linear-gradient(180deg, rgba(245, 158, 11, 0.08) 0%, color-mix(in oklab, var(--arch-shell) 70%, #17243c) 100%);
  }

  .highlight-stage:hover {
    border-color: rgba(245, 158, 11, 0.75);
  }

  .evidence-types-mini {
    display: flex;
    gap: 5px;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  .chip {
    font-size: 0.62rem;
    font-weight: 800;
    padding: 3px 7px;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  .chip-fact { background: rgba(20, 122, 105, 0.3); color: #5fd4bf; border: 1px solid rgba(95, 212, 191, 0.5); }
  .chip-likely { background: rgba(198, 81, 47, 0.28); color: #ff9b80; border: 1px solid rgba(255, 125, 85, 0.5); }
  .chip-hypo { background: rgba(59, 130, 246, 0.25); color: #93c5fd; border: 1px solid rgba(93, 197, 253, 0.4); }

  /* Flow Connectors */
  .flow-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 88px;
    min-width: 88px;
    flex-shrink: 0;
    position: relative;
    padding: 0;
    gap: 8px;
  }

  @media (max-width: 960px) {
    .flow-connector {
      width: 100%;
      min-width: 100%;
      height: 32px;
    }
  }

  .connector-line {
    width: 100%;
    min-width: 26px;
    height: 2px;
    background: #33476d;
    position: relative;
    overflow: visible;
  }

  .connector-line::after {
    content: "";
    position: absolute;
    right: 0;
    top: -4px;
    width: 0;
    height: 0;
    border-left: 6px solid #5878ab;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
  }

  .flow-bubble {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #73a4ff;
    top: -2px;
    box-shadow: 0 0 6px #73a4ff;
    animation: flowPulse 2s linear infinite;
  }

  .flow-b1 { animation-delay: 0.1s; }
  .flow-b2 { animation-delay: 0.5s; }
  .flow-b3 { animation-delay: 0.9s; }
  .flow-b4 { animation-delay: 1.3s; }

  @keyframes flowPulse {
    0% { left: 0%; opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { left: 80%; opacity: 0; }
  }

  .connector-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 22px;
    padding: 4px 8px;
    border-radius: 999px;
    background: rgba(120, 146, 196, 0.08);
    border: 1px solid rgba(141, 164, 203, 0.25);
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #9eb3d8;
    text-align: center;
    line-height: 1.1;
    white-space: nowrap;
    max-width: 96px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
  }

  /* Tier Bridge */
  .tier-bridge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 6px 0;
  }

  .bridge-line {
    height: 1px;
    background: color-mix(in oklab, var(--arch-shell-border) 75%, transparent);
    flex: 1;
    position: relative;
  }

  .bridge-label {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #718ebf;
    text-transform: uppercase;
    padding: 3px 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--arch-shell-border);
    border-radius: 999px;
  }

  @media (max-width: 1200px) {
    .arch-canvas {
      padding: 18px;
    }
  }
</style>


