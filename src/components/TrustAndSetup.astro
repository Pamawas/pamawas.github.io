---
const controls = [
  { tone: 'fjord', title: 'Cryptographically signed invocations', body: 'Caller identity, audience, timestamp, nonce, scope, and payload SHA-256 signatures are strictly validated across service boundaries.' },
  { tone: 'moss', title: 'Least-privilege role ownership', body: 'Each microservice owns write permissions exclusively to its assigned tables via discrete database credentials; read-only adapters cannot write.' },
  { tone: 'ochre', title: 'Independent multi-channel delivery', body: 'Discord, Telegram, and email delivery adapters execute and retry independently following durable report creation.' },
  { tone: 'falu', title: 'Empirical human review loops', body: 'Reviewers grade incident findings as correct, partial, incorrect, or unknown—tracking false confidence metrics over time.' },
];
---
<section id="trust" class="trust-section" aria-labelledby="trust-title">
  <div class="shell trust-layout">
    <header class="section-header reveal-item">
      <div>
        <p class="eyebrow">Reliability & governance</p>
        <h2 id="trust-title">Safe when requests repeat.<br />Honest when evidence stops.</h2>
      </div>
      <p>
        Application contracts enforce authentication, replay protection, idempotency, bounded egress, and durable recovery.
      </p>
    </header>

    <div class="control-list">
      {controls.map((item, index) => (
        <article class="control-item reveal-item" style={`--reveal-delay: ${index * 70}ms`}>
          <span class={`control-dot dot-${item.tone}`} aria-hidden="true"></span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="quick-start" class="closing-section" aria-labelledby="closing-title">
  <div class="shell closing-layout">
    <div class="closing-copy reveal-item">
      <p class="eyebrow">Open source &middot; MIT</p>
      <h2 id="closing-title">Inspect the contracts.<br />Run the stack.</h2>
      <p class="closing-tagline">For infrastructure teams who would rather sleep than chase alerts.</p>
      <p class="closing-desc">
        Pamawas is built in public across focused services. The normative system design defines the target; tests decide whether the code is compliant.
      </p>
      <div class="closing-actions">
        <a class="button button-primary" href="https://github.com/Pamawas" target="_blank" rel="noopener">
          <span>Browse Pamawas</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="https://github.com/Pamawas/pamawas.github.io" target="_blank" rel="noopener">
          <span>Landing source</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <div class="terminal-panel reveal-item">
      <header>
        <span><i class="terminal-dot" aria-hidden="true"></i>Local development</span>
        <button id="copy-code-btn" class="copy-btn" type="button" aria-label="Copy quick start command">
          Copy
        </button>
      </header>
      <pre id="quickstart-code"><code><b>git clone</b> https://github.com/Pamawas/pamawas-infra.git
<b>cd</b> pamawas-infra/docker-compose
<b>cp</b> .env.example .env
<span class="cmd-comment"># configure local keys in .env</span>
<b>docker compose</b> up -d</code></pre>
      <footer>Development stack &middot; review configuration first</footer>
      <p id="copy-status" class="sr-only" aria-live="polite"></p>
    </div>
  </div>
</section>
