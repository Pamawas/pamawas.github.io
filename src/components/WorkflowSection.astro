---
const steps = [
  { n: '01', title: 'Normalize', stat: '2,300', body: 'Authenticated Grafana and generic webhook events enter one normalized event model.', meta: 'Illustrative input' },
  { n: '02', title: 'Correlate', stat: '17', body: 'Versioned time-window, service, and identity-label rules group compatible events into incidents.', meta: 'Illustrative output' },
  { n: '03', title: 'Investigate', stat: '1 digest', body: 'A bounded agent queries configured sources, classifies certainty, and returns unknown when evidence is insufficient.', meta: 'Evidence first' },
];
---
<section id="outcome" class="outcome-section" aria-labelledby="outcome-title">
  <div class="shell outcome-grid reveal-item">
    <header class="section-heading">
      <p class="eyebrow">The operational shift</p>
      <h2 id="outcome-title">Wake up to evidence,<br />not an alert queue.</h2>
      <p>Illustrative scenario based on the project success target, not a production benchmark.</p>
    </header>
    <div class="outcome-comparison">
      <div class="outcome-before">
        <span class="data-label">Without Pamawas · 06:00</span>
        <strong>2,317</strong>
        <p>alerts waiting across five disconnected sources.</p>
        <div class="noise-lines" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      </div>
      <div class="outcome-after">
        <span class="data-label">With Pamawas · 06:00</span>
        <strong>17</strong>
        <p>incidents in one prioritized daily digest, evidence attached.</p>
        <div class="result-line"><span>INC-892</span><b>Likely cause identified</b><small>87%</small></div>
      </div>
    </div>
  </div>
</section>

<section id="workflow" class="workflow-section" aria-labelledby="workflow-title">
  <div class="shell workflow-layout">
    <header class="section-heading reveal-item">
      <p class="eyebrow">How it works</p>
      <h2 id="workflow-title">Structure first.<br />Reason second.</h2>
      <p>Versioned correlation rules reduce the search space before a model is allowed to interpret anything. The figures shown are illustrative.</p>
    </header>
    <ol class="workflow-list">
      {steps.map((step, index) => (
        <li class="workflow-step reveal-item" style={`--reveal-delay: ${index * 80}ms`}>
          <span class="step-number">{step.n}</span>
          <div><h3>{step.title}</h3><p>{step.body}</p><small>{step.meta}</small></div>
          <strong>{step.stat}</strong>
        </li>
      ))}
    </ol>
  </div>
</section>
