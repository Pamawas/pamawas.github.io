---
const evidence = [
  ['FACT', 'Prometheus', 'Active connections reached the configured maximum.'],
  ['FACT', 'Loki', 'Connection pool timeouts increased in the same window.'],
  ['LIKELY CAUSE', 'Investigator', 'Pool exhaustion likely caused the request failures.'],
  ['UNKNOWN', 'Deployment adapter', 'Change correlation is unavailable until a real adapter is configured.'],
];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="shell hero-grid">
    <div class="hero-copy reveal-item">
      <p class="eyebrow">Open-source incident intelligence</p>
      <h1 id="hero-title">From alert noise<br/><em>to evidence.</em></h1>
      <p class="hero-body">Pamawas turns authenticated infrastructure events into traceable incidents, investigates through bounded read-only tools, and reports what is known, likely, and still unknown.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#workflow">Follow the workflow <span aria-hidden="true">↓</span></a>
        <a class="button button-secondary" href="https://github.com/Pamawas" target="_blank" rel="noopener">Explore the code <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="hero-principles" aria-label="Core guarantees">
        <li>Deterministic correlation</li><li>No fabricated evidence</li><li>Exactly-once durable effects</li>
      </ul>
    </div>
    <article class="signal-card reveal-item" aria-label="Illustrative investigation output">
      <header><span><i></i> Representative output</span><code>irun_example</code></header>
      <div class="signal-heading">
        <div><span class="severity">HIGH</span><span class="state">completed</span></div>
        <h2>Checkout failures followed a connection ceiling.</h2>
        <p>Illustrative data, not a production benchmark.</p>
      </div>
      <div class="signal-list">
        {evidence.map(([type, source, text]) => <div><span class={`signal-type ${type.toLowerCase().replace(' ', '-')}`}>{type}</span><p>{text}</p><small>{source}</small></div>)}
      </div>
      <footer><span>4 evidence items</span><span>0 write actions</span><span>provenance linked</span></footer>
    </article>
  </div>
</section>
